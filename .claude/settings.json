{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)"],
    "allow": ["Read(./.env.example)"],
    "ask": ["Bash(git commit:*)", "Bash(git push:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/protect-migrations.sh"
          }
        ]
      }
    ]
  }
}
