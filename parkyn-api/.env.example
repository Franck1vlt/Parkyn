# Postgres
POSTGRES_DB = your_postgres_db_name
POSTGRES_USER = your_postgres_user_name
POSTGRES_PASSWORD = your_postgres_password

# JWT 
JWT_SECRET = your_jwt_secret
JWT_EXPIRATION_MS = 3600000
REFRESH_EXPIRATION_DAYS = 1

# CORS 
CORS_ALLOWED_ORIGINS = your_cors_allowed_origins

# Mail
MAIL_HOST = your_mail_host
MAIL_PORT = your_mail_port
MAIL_USERNAME = your_mail_username
MAIL_PASSWORD = your_mail_password
MAIL_SMTP_AUTH = true
MAIL_SMTP_STARTTLS = true
MAIL_FROM = your_mail_from_address
FRONTEND_URL = your_frontend_url

# Pool d'envoi des emails (ne pas laisser de valeur vide : le démarrage échouerait)
MAIL_ASYNC_CORE_SIZE = 2
MAIL_ASYNC_MAX_SIZE = 4
MAIL_ASYNC_QUEUE_CAPACITY = 100